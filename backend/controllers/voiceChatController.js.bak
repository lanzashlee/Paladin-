    patterns: [/earthquake.*deductible\b/i, /deductible.*earthquake\b/i],
    reply:
      'Select the deductible amount from the available options.',
  },
  {
    patterns: [/replacement cost\b.*\bdwelling\b/i, /dwelling cost\b/i],
    reply:
      'Provide the replacement cost of your home.',
  },
  // PART 9: FLOOD INSURANCE
  {
    patterns: [/flood.*property address\b/i, /flood coverage\b/i],
