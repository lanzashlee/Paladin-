  // PART 12: CARRIER DIRECTORY & PRODUCT MAPPING
  {
    patterns: [/carrier.*working\b/i, /what carrier\b/i],
    reply: 'Provide the name of the carrier you work with.',
  },
  {
    patterns: [/primary lines\b.*\bbusiness\b/i, /lines of business\b/i],
