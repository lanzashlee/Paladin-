  },
  // PART 10: UMBRELLA / EXCESS LIABILITY
  {
    patterns: [/umbrella.*name\b/i, /umbrella liability limit\b/i],
    reply:
      'Provide either your full name (for personal umbrella) or business name (for commercial umbrella).',
  },
  {
    patterns: [/underlying.*policy\b/i, /underlying.*carrier\b/i],
    reply:
      'If applicable, provide the carrier\'s name for the underlying policies.',
