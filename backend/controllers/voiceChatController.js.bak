  {
    patterns: [/umbrella claims\b/i, /prior.*umbrella\b/i],
    reply: 'If applicable, provide details on prior claims.',
  },
  // PART 11: SPECIALTY PRODUCTS
  {
    patterns: [/personally identifiable\b/i, /pii\b/i],
    reply:
      'Indicate if you store PII, as it impacts cyber liability coverage.',
  },
  {
    patterns: [/multi-factor authentication\b/i, /mfa\b/i],
    reply:
      'Indicate Yes or No. MFA is important for cyber liability coverage.',
  },
  {
    patterns: [/cyber incidents\b/i, /prior cyber\b/i],
    reply:
      'If yes, provide details including dates and costs.',
