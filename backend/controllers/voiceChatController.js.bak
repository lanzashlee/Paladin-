  {
    patterns: [/umbrella.*limit\b/i, /umbrella liability limit\b/i],
    reply:
      'Select the desired limit for your umbrella policy.',
  },
  {
    patterns: [/pool\b.*\bumbrella\b/i, /swimming pool\b.*\bumbrella\b/i],
